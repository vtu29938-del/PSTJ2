public class Solution {
    public static int maximumWealth(int[][] accounts) {
        int maxWealth = 0;
        
        for (int[] customer : accounts) {
            int currentWealth = 0;
            for (int bank : customer) {
                currentWealth += bank;
            }
            maxWealth = Math.max(maxWealth, currentWealth);
        }
        
        return maxWealth;
    }

    public static void main(String[] args) {
        int[][] accounts1 = {{1, 2, 3}, {3, 2, 1}};
        int[][] accounts2 = {{1, 5}, {7, 3}, {3, 5}};
        int[][] accounts3 = {{2, 8, 7}, {7, 1, 3}, {1, 9, 5}};

        System.out.println("Example 1 Output: " + maximumWealth(accounts1)); // Expected: 6
        System.out.println("Example 2 Output: " + maximumWealth(accounts2)); // Expected: 10
        System.out.println("Example 3 Output: " + maximumWealth(accounts3)); // Expected: 17
    }
}
