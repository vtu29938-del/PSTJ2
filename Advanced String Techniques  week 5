import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class Solution {
    public List<String> findAndReplacePattern(String[] words, String pattern) {
        List<String> result = new ArrayList<>();
        
        for (String word : words) {
            if (matches(word, pattern)) {
                result.add(word);
            }
        }
        
        return result;
    }

    private boolean matches(String word, String pattern) {
        // Maps pattern character -> word character
        Map<Character, Character> pToW = new HashMap<>();
        // Maps word character -> pattern character
        Map<Character, Character> wToP = new HashMap<>();

        for (int i = 0; i < pattern.length(); i++) {
            char pChar = pattern.charAt(i);
            char wChar = word.charAt(i);

            // Check pattern to word mapping consistency
            if (pToW.containsKey(pChar) && pToW.get(pChar) != wChar) {
                return false;
            }
            
            // Check word to pattern mapping consistency (ensures bijection)
            if (wToP.containsKey(wChar) && wToP.get(wChar) != pChar) {
                return false;
            }

            pToW.put(pChar, wChar);
            wToP.put(wChar, pChar);
        }

        return true;
    }
}
